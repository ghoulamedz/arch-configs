[Desktop Entry]
# ~/.local/share/applications/pkg-remove.desktop
Type=Application
Name=Remove Package
GenericName=Package manager
Comment=Uninstall packages, their unused dependencies and their configuration
Exec=foot --app-id=float-pkg-remove -e pkg-remove
Icon=edit-delete
Terminal=false
Categories=System;PackageManager;
Keywords=uninstall;remove;delete;pacman;package;
StartupNotify=false
