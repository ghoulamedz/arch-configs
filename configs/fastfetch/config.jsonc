{
  // ~/.config/fastfetch/config.jsonc — the system information banner.
  // Reference: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration

  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // No ASCII-art logo. The terminal is more useful than a picture of an Arch
  // logo, and this is meant to be a quick summary.
  "logo": {
    "type": "none"
  },

  "display": {
    "separator": "  ",
    "color": {
      // Section keys in the Tokyo Night accent colour.
      "keys": "blue"
    }
  },

  "modules": [
    "title",      // user@host
    "separator",
    "os",         // distribution and version
    "kernel",     // kernel release
    "uptime",
    "packages",   // package counts by manager
    "shell",
    "wm",         // Hyprland
    "terminal",
    "cpu",        // model, cores, current load
    "gpu",        // both GPUs, with the driver
    "memory",     // RAM and zram
    "disk",       // btrfs usage
    "localip",    // LAN address
    "battery",
    "separator",
    "colors"      // the terminal palette, useful for checking a theme
  ]
}
